# ===================================
# WHITE-LABEL CHATBOT - ENVIRONMENT TEMPLATE
# ===================================
# 
# INSTRUCTIONS:
# 1. Copy this file to .env_API
# 2. Replace placeholder values with actual credentials
# 3. NEVER commit .env to version control!
#
# ===================================

# ===================================
# DATABASE
# ===================================
DATABASE_URL=mysql+pymysql://root@localhost:3306/chatbot_db

# ===================================
# API KEYS
# ===================================

# Pinecone (Vector Database)
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=help-desk-chatbot
PINECONE_HOST=https://your-index-name.svc.region.pinecone.io

# OpenAI (Fallback LLM)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic Claude (Primary LLM)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ===================================
# APPLICATION SETTINGS
# ===================================

# Company Name (displayed in chat)
COMPANY_NAME=Your Company Name

# Backend API URL (for frontend)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# ===================================
# FEATURE FLAGS
# ===================================

ENABLE_VOICE=true
ENABLE_FILE_UPLOAD=true
ENABLE_AGENT_HANDOFF=true
REQUIRE_AUTH=true

# ===================================
# OPTIONAL: EMAIL/SMS NOTIFICATIONS
# ===================================

# SMTP Settings (for email notifications)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASSWORD=your_app_password

# Twilio (for SMS notifications)
# TWILIO_ACCOUNT_SID=your_twilio_sid
# TWILIO_AUTH_TOKEN=your_twilio_token
# TWILIO_PHONE_NUMBER=+1234567890

# ===================================
# SECURITY
# ===================================

# JWT Secret (generate a strong random string)
JWT_SECRET=your_super_secret_jwt_key_change_this

# Session secret
SESSION_SECRET=your_session_secret_change_this

# ===================================
# DEPLOYMENT (Production Only)
# ===================================

# NODE_ENV=production
# PORT=8000
# ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
